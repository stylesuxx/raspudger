#!/usr/bin/env bash
# Thin launcher so `./rasp ...` works from the repo without installing.
# Prefers the project virtualenv when present.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -x "$here/.venv/bin/python" ]]; then
  exec "$here/.venv/bin/python" -m raspudger.cli "$@"
fi
exec python3 -m raspudger.cli "$@"
