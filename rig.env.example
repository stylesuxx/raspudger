# Rig connection settings for `rasp --rig-config rig.env`. Host-specific, so
# copy this to rig.env (gitignored) and fill it in. `--rig-host` overrides
# RIG_PI_HOST, the one value that changes with DHCP or a reflash.
#
# Paths (RIG_PI_SSH_KEY, RIG_PI_KNOWN_HOSTS) are on the host; rasp mounts
# them into the container and the server reads them from there.

RIG_PI_HOST=10.0.0.42
RIG_PI_USER=rig
RIG_PI_SSH_KEY=data/pi-sim/id_ed25519
RIG_PI_SSH_PORT=22

# A dedicated known_hosts for the disposable Pi; clear it to re-trust a reflash.
# RIG_PI_KNOWN_HOSTS=data/pi-known_hosts

RIG_UART_PORT=5000

# GPIO pin map (BCM numbers) and relay polarity. false suits an active-low,
# opto-isolated relay driven through NO/COM.
RIG_PIN_POWER=17
RIG_PIN_UART_TX=14
RIG_POWER_ACTIVE_HIGH=false

# Against the dev sim instead of hardware: set RIG_PI_HOST=pi-sim and launch with
# `rasp ... --network raspudger_default` so the container reaches the sim.
