#!/usr/bin/env bash
# Rewrite the ser2net serial connector to new line settings and restart it, so
# the rig can drive a DUT whose console is not the provisioned 115200 8N1.
# Usage: rig-serial-config <mode> [flow]
#   mode: a ser2net serialdev mode, e.g. 115200n81
#   flow: none (default), rtscts, or xonxoff
set -euo pipefail

mode="${1:?usage: rig-serial-config <mode> [flow]}"
flow="${2:-none}"

# shellcheck disable=SC1091
. /etc/rig-serial.env

case "$flow" in
  none) options="" ;;
  rtscts) options=",rtscts" ;;
  xonxoff) options=",xonxoff" ;;
  *) echo "unknown flow: $flow (use none|rtscts|xonxoff)" >&2; exit 2 ;;
esac

# ser2net traces both directions to one file in wire order, so a read-only
# monitor tailing it sees the session as it happened: the host's bytes and the
# device's replies interleaved exactly as they crossed the line. The file is
# world-readable so the monitor can tail it as the rig user, and is appended
# across restarts so the record survives a line reconfigure.
trace="${RIG_UART_TRACE:-/var/log/rig/uart.log}"
install -d -m 0755 "$(dirname "$trace")"
touch "$trace"
chmod 0644 "$trace"

cat >/etc/ser2net.yaml <<EOF
%YAML 1.1
---
connection: &dut
    accepter: tcp,${RIG_UART_PORT}
    enable: on
    options:
      kickolduser: true
      trace-both: '${trace}'
    connector: serialdev,${RIG_UART_DEVICE},${mode}${options},local
EOF

systemctl restart ser2net
